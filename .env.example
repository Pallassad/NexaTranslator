# Copy file này thành ".env" rồi điền key, HOẶC dùng lệnh: npm run dev -- set-key claude
# File .env KHÔNG được đưa lên Git. Engine nào để trống thì tool tự bỏ qua.

# Claude (Anthropic) – engine trả phí mặc định khi Google bị chặn
CLAUDE_API_KEY=

# AI dạng OpenAI-compatible (Gemini, OpenAI, DeepSeek...) – không bắt buộc
AI_API_KEY=
# AI_MODEL=
# AI_BASE_URL=

# Không bắt buộc
AZURE_KEY=
AZURE_REGION=southeastasia
DEEPL_KEY=
